# ---------------------------------------------------------------
# Network: reuse the Learner Lab default VPC and a public subnet
# ---------------------------------------------------------------
data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "public" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
  filter {
    name   = "default-for-az"
    values = ["true"]
  }
  filter {
    name   = "availability-zone"
    values = ["us-east-1a", "us-east-1b", "us-east-1c", "us-east-1d", "us-east-1f"]
  }
}

# Latest Ubuntu 24.04 LTS AMI published by Canonical
data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"]

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"]
  }
  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# ---------------------------------------------------------------
# SSH key pair generated by Terraform; private key saved for Ansible
# ---------------------------------------------------------------
resource "tls_private_key" "deployer" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "deployer" {
  key_name   = "${var.project}-deployer"
  public_key = tls_private_key.deployer.public_key_openssh
}

resource "local_sensitive_file" "private_key" {
  content         = tls_private_key.deployer.private_key_pem
  filename        = "${path.module}/../ansible/keys/${var.project}.pem"
  file_permission = "0600"
}

# ---------------------------------------------------------------
# Security group: website, SSH, Jenkins
# ---------------------------------------------------------------
resource "aws_security_group" "web" {
  name        = "${var.project}-sg"
  description = "incidentIQ web app, Jenkins and SSH"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "HTTP - incidentIQ web application"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "SSH for Ansible"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = var.ssh_ingress_cidrs
  }

  ingress {
    description = "Jenkins UI"
    from_port   = 8080
    to_port     = 8080
    protocol    = "tcp"
    cidr_blocks = var.monitoring_ingress_cidrs
  }

  egress {
    description = "All outbound"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "${var.project}-sg" }
}

# ---------------------------------------------------------------
# EC2 instance
# ---------------------------------------------------------------
resource "aws_instance" "web" {
  ami                         = data.aws_ami.ubuntu.id
  instance_type               = var.instance_type
  subnet_id                   = data.aws_subnets.public.ids[0]
  vpc_security_group_ids      = [aws_security_group.web.id]
  key_name                    = aws_key_pair.deployer.key_name
  associate_public_ip_address = true

  root_block_device {
    volume_size           = var.root_volume_gb
    volume_type           = "gp3"
    encrypted             = true
    delete_on_termination = true
  }

  metadata_options {
    http_tokens = "required" # IMDSv2 only
  }

  # Minimal bootstrap; everything else is Ansible's job.
  user_data = <<-EOT
    #!/bin/bash
    hostnamectl set-hostname ${var.project}-web
    echo "bootstrapped by terraform at $(date -Is)" > /etc/incidentiq-bootstrap
  EOT

  tags = {
    Name = "${var.project}-web"
    Role = "jenkins-docker"
  }
}

# Static public IP so the URL, inventory and CI secret survive lab restarts
resource "aws_eip" "web" {
  instance = aws_instance.web.id
  domain   = "vpc"
  tags     = { Name = "${var.project}-eip" }
}

# ---------------------------------------------------------------
# Hand-off to Ansible: generated inventory
# ---------------------------------------------------------------
resource "local_file" "ansible_inventory" {
  filename = "${path.module}/../ansible/inventory/hosts.ini"
  content = templatefile("${path.module}/inventory.tftpl", {
    host     = aws_eip.web.public_ip
    key_file = "keys/${var.project}.pem"
  })
}
